# Kalshi API credentials (https://kalshi.com -> account -> API keys)
# Kalshi uses RSA key-pair auth: you get a key ID and download a private key file.
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Use the demo environment while developing:
#   https://demo-api.kalshi.co/trade-api/v2  (paper)
#   https://api.elections.kalshi.com/trade-api/v2  (production)
KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2

# The Odds API (free tier ~500 req/mo) — optional, for model calibration
ODDS_API_KEY=

# Polymarket needs no key for public market data.
